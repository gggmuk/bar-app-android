<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#000000</color>
    <color name="black_background">#121212</color>
    <color name="card_background">#1E1E1E</color>
    <color name="green_success">#00E676</color>
    <color name="grey_text">#B0BEC5</color>
    <color name="neon_green">#39FF14</color>
    <color name="neon_green_dim">#20800A</color>
    <color name="red_accent">#FF1744</color>
    <color name="red_dark">#D50000</color>
    <color name="white">#FFFFFF</color>
    <string name="app_name">BarApp</string>
    <string name="navigation_drawer_close">Закрыть меню</string>
    <string name="navigation_drawer_open">Открыть меню</string>
    <style name="Theme.BarApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        
        <item name="colorPrimary">@color/neon_green</item>
        <item name="colorPrimaryVariant">@color/neon_green_dim</item>
        <item name="colorOnPrimary">@color/black</item>
        
        <item name="colorSecondary">@color/neon_green</item>
        <item name="colorSecondaryVariant">@color/neon_green_dim</item>
        <item name="colorOnSecondary">@color/black</item>
        
        <item name="android:statusBarColor">@color/black</item>
        
        <item name="android:windowBackground">@color/black_background</item>
        <item name="android:textColor">@color/white</item>
        
        
        <item name="materialButtonStyle">@style/Widget.BarApp.Button.Outlined</item>

        
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimations</item>
    </style>
    <style name="Widget.BarApp.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/neon_green</item>
        <item name="strokeColor">@color/neon_green</item>
        <item name="strokeWidth">2dp</item>
        <item name="rippleColor">@color/neon_green</item>
        <item name="cornerRadius">24dp</item>
    </style>
    <style name="WindowAnimations" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>
</resources>